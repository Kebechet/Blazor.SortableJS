@attribute [Stories("SortableJS/Groups")]

<Stories TComponent="SortableStoryArgs">
    <Story Name="Connected groups with pull and put policies">
        <Description>
            Two lists sharing one group name, with different pull/put policies. Backlog allows items to be taken out but refuses anything dropped in, so a drag in that direction is rejected and both collections stay unchanged.
        </Description>
        <Template Context="context">
            <p class="demo-hint">Drag from <strong>Backlog</strong> to <strong>Done</strong>: the item moves, keeping the same identity. Drag the other way and nothing happens - Backlog has <code>put</code> disabled, so the drop is refused.</p>
            <div class="demo-board">
                <div>
                    <h3>Backlog (put disabled)</h3>
                    <Sortable TItem="DemoItem"
                              Items="_backlog"
                              Options="@StorySupport.WithFallback(_sourceOptions, context.Args)"
                              ItemKeySelector="@(item => item.Key)"
                              OnEnd="ModelChanged"
                              RootClass="demo-list"
                              ItemClass="demo-item"
                              data-testid="backlog-list"
                              data-fallback-forced="@StorySupport.FallbackAttributeValue(context.Args)">
                        <ItemTemplate Context="item">
                            <span class="demo-item-content" data-item-key="@item.Key" data-testid="item-@item.Key">@item.Label</span>
                        </ItemTemplate>
                    </Sortable>
                </div>
                <div>
                    <h3>Done</h3>
                    <Sortable TItem="DemoItem"
                              Items="_done"
                              Options="@StorySupport.WithFallback(_destinationOptions, context.Args)"
                              ItemKeySelector="@(item => item.Key)"
                              OnEnd="ModelChanged"
                              RootClass="demo-list"
                              ItemClass="demo-item"
                              data-testid="done-list"
                              data-fallback-forced="@StorySupport.FallbackAttributeValue(context.Args)">
                        <ItemTemplate Context="item">
                            <span class="demo-item-content" data-item-key="@item.Key" data-testid="item-@item.Key">@item.Label</span>
                        </ItemTemplate>
                    </Sortable>
                </div>
            </div>
            <ModelState Json="@ModelJson" />
        </Template>
    </Story>
</Stories>

@code {
    private readonly List<DemoItem> _backlog = [new("design", "Design"), new("implement", "Implement")];
    private readonly List<DemoItem> _done = [new("scaffold", "Scaffold")];
    private readonly SortableOptions _sourceOptions = new()
    {
        AnimationDuration = 150,
        Group = new SortableGroupOptions
        {
            Name = "backlog",
            PullMode = PullMode.ListedGroups,
            PullGroups = new[] { "done" },
            PutMode = PutMode.Disabled
        }
    };
    private readonly SortableOptions _destinationOptions = new()
    {
        AnimationDuration = 150,
        Group = new SortableGroupOptions
        {
            Name = "done",
            PullMode = PullMode.Disabled,
            PutMode = PutMode.ListedGroups,
            PutGroups = new[] { "backlog" }
        }
    };

    private string ModelJson => StorySupport.SerializeState(new DemoCollection("backlog", _backlog), new DemoCollection("done", _done));

    private void ModelChanged() => StateHasChanged();
}
