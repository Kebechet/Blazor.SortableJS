@attribute [Stories("SortableJS/Features")]

<Stories TComponent="Sortable<string>">
    <Story Name="Swap plugin">
        <Template>
            <Sortable TItem="string" Items="_items" Options="_options" RootClass="demo-list demo-horizontal" ItemClass="demo-item">
                <ItemTemplate Context="item">@item</ItemTemplate>
            </Sortable>
        </Template>
    </Story>
</Stories>

@code {
    private readonly List<string> _items = new() { "One", "Two", "Three", "Four" };
    private readonly SortableOptions _options = new()
    {
        AnimationDuration = 150,
        Direction = SortableDirection.Horizontal,
        IsSwapEnabled = true,
        SwapClass = "demo-swap"
    };
}
