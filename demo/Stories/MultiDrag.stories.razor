@attribute [Stories("SortableJS/MultiDrag")]

<Stories TComponent="SortableStoryArgs">
    <Story Name="MultiDrag">
        <Description>
            The MultiDrag plugin. Several items can be selected and dragged as one group, and their relative order is preserved at the destination.
        </Description>
        <Template Context="context">
            <p class="demo-hint">Hold <strong>Ctrl</strong> (or Cmd, when configured with Meta) to select several items, then drag the selection. All selected rows move together and keep their relative order.</p>
            <Sortable TItem="DemoItem"
                      Items="_items"
                      Options="@StorySupport.WithFallback(_options, context.Args)"
                      ItemKeySelector="@(item => item.Key)"
                      OnEnd="ModelChanged"
                      RootClass="demo-list"
                      ItemClass="demo-item"
                      data-testid="multidrag-list"
                      data-fallback-forced="@StorySupport.FallbackAttributeValue(context.Args)">
                <ItemTemplate Context="item">
                    <span class="demo-item-content" data-item-key="@item.Key" data-testid="item-@item.Key">@item.Label</span>
                </ItemTemplate>
            </Sortable>
            <ModelState Json="@ModelJson" />
        </Template>
    </Story>
</Stories>

@code {
    private readonly List<DemoItem> _items =
    [
        new("alpha", "Alpha"),
        new("bravo", "Bravo"),
        new("charlie", "Charlie"),
        new("delta", "Delta"),
        new("echo", "Echo"),
        new("foxtrot", "Foxtrot")
    ];

    private readonly SortableOptions _options = new()
    {
        AnimationDuration = 150,
        IsMultiDragEnabled = true,
        MultiDragKey = SortableMultiDragKey.Control,
        SelectedClass = "demo-selected"
    };

    private string ModelJson => StorySupport.SerializeState(new DemoCollection("items", _items));

    private void ModelChanged() => StateHasChanged();
}
