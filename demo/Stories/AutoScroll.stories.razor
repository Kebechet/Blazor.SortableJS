@attribute [Stories("SortableJS/Features")]

<Stories TComponent="Sortable<string>">
    <Story Name="Auto-scroll">
        <Template>
            <div class="demo-scroll-container">
                <Sortable TItem="string" Items="_items" Options="_options" RootClass="demo-list" ItemClass="demo-item">
                    <ItemTemplate Context="item">@item</ItemTemplate>
                </Sortable>
            </div>
        </Template>
    </Story>
</Stories>

@code {
    private readonly List<string> _items = Enumerable.Range(1, 20).Select(number => $"Scrollable item {number}").ToList();
    private readonly SortableOptions _options = new()
    {
        AnimationDuration = 100,
        IsAutoScrollEnabled = true,
        ScrollSensitivity = 50,
        ScrollSpeed = 14,
        ShouldBubbleScroll = true
    };
}
