@attribute [Stories("SortableJS/Basic")]

<Stories TComponent="Sortable<string>">
    <Story Name="Reorder in place">
        <Template>
            <Sortable TItem="string" Items="_items" Options="_options" RootClass="demo-list" ItemClass="demo-item">
                <ItemTemplate Context="item">@item</ItemTemplate>
            </Sortable>
        </Template>
    </Story>
</Stories>

@code {
    private readonly List<string> _items = new() { "Read brief", "Build API", "Verify package" };
    private readonly SortableOptions _options = new() { AnimationDuration = 150, GhostClass = "demo-ghost", ChosenClass = "demo-chosen" };
}
