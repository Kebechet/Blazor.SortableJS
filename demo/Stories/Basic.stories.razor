@attribute [Stories("SortableJS/Basic")]

<Stories TComponent="SortableStoryArgs">
    <Story Name="Reorder in place">
        <Description>
            The simplest case: one list, drag to reorder. The panel underneath prints the bound <code>List&lt;DemoItem&gt;</code> after every drop, including each item's CLR identity, so you can see that reordering moves the existing instances rather than recreating them.
        </Description>
        <Template Context="context">
            <p class="demo-hint">Drag a row to reorder. Watch the panel below: the order changes but every <code>identity</code> stays equal to its <code>initialIdentity</code>, because the bound list is reordered in place.</p>
            <Sortable TItem="DemoItem"
                      Items="_items"
                      Options="@StorySupport.WithFallback(_options, context.Args)"
                      ItemKeySelector="@(item => item.Key)"
                      OnEnd="ModelChanged"
                      RootClass="demo-list"
                      ItemClass="demo-item"
                      data-testid="basic-list"
                      data-fallback-forced="@StorySupport.FallbackAttributeValue(context.Args)">
                <ItemTemplate Context="item">
                    <span class="demo-item-content" data-item-key="@item.Key" data-testid="item-@item.Key">@item.Label</span>
                </ItemTemplate>
            </Sortable>
            <ModelState Json="@ModelJson" />
        </Template>
    </Story>
</Stories>

@code {
    private readonly List<DemoItem> _items =
    [
        new("read-brief", "Read brief"),
        new("build-api", "Build API"),
        new("verify-package", "Verify package")
    ];

    private readonly SortableOptions _options = new() { AnimationDuration = 150, GhostClass = "demo-ghost", ChosenClass = "demo-chosen" };

    private string ModelJson => StorySupport.SerializeState(new DemoCollection("items", _items));

    private void ModelChanged() => StateHasChanged();
}
